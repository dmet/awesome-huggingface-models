# --- Runway --------------------------------------------------------------
# https://dev.runwayml.com/ -> API Keys. The runwayml SDK reads this name.
RUNWAYML_API_SECRET=your-runway-api-secret-here
RUNWAY_MODEL=gen4.5
RUNWAY_RATIO=1280:720
# gen4.5 accepts any integer 2-10 (confirmed from the SDK typed params).
RUNWAY_DURATIONS=2,3,4,5,6,7,8,9,10

# --- Render --------------------------------------------------------------
RENDER_FPS=24
RENDER_SIZE=1280x720
ANIMATIC_FONT=C:/Windows/Fonts/arial.ttf

# --- Cutting -------------------------------------------------------------
BEATS_PER_BAR=4
MIN_BARS_PER_SHOT=2
MAX_BARS_PER_SHOT=4
